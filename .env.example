# ─── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
API_BASE_URL=http://localhost:3001

# ─── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://ocj_user:ocj_password@localhost:5432/ocj_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Firebase Admin SDK ─────────────────────────────────────────────────────────
# IMPORTANT: Never commit the actual service account JSON — inject via secret manager
# For local dev: place firebase-service-account.json in apps/api/ (git-ignored)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_EMULATOR_HOST=localhost:9099

# ─── Firebase Client SDK (web app) ──────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_USE_FIREBASE_EMULATOR=true

# ─── Session / Security ──────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:5173
AUTH_VERSION_CACHE_TTL_SECONDS=60

# ─── Rate Limits ─────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_GENERAL=120

# ─── Execution Limits ────────────────────────────────────────────────────────────
SUBMISSION_PER_USER_PER_MIN=10
SUBMISSION_PER_USER_PER_DAY=100
RUN_PER_USER_PER_HOUR=20

# ─── Queue ───────────────────────────────────────────────────────────────────────
BULL_CONCURRENCY=2
MAX_QUEUE_WAIT_SECONDS=10
